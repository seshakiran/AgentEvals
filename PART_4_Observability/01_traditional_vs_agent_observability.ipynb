    "print(\"│     • Tool parameters                             │\")\n",
    "print(\"│     • Tool results                                │\")\n",
    "print(\"│                                             │\�─\")\n",
    "print(\"│  3. REASONING                                     │\")\n",
    "print(\"│     • LLM reasoning steps                         │\")\n",
    "print(\"│     • Decision points                             │\")\n",
    "print(\"│                                             │\")\n",
    "print(\"│  4. STATE                                         │\")\n",
    "print(\"│     • Memory contents                             │\")\n",
    "print(\"│     • State changes                               │\")\n",
    "print(\"│                                             │\")\n",
    "print(\"│  5. ERRORS                                        │\")\n",
    "print(\"│     • Tool failures                               │\")\n",
    "print(\"│     • Hallucinations                              │\")\n",
