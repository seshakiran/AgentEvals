   "source": [
    "# 📖 Types of Agent Evals\n",
    "\n",
    "---\n",
    "\n",
    "## 🎯 Learning Objectives\n",
    "\n",
    "1. Understand each type of eval in depth\n",
    "2. Know when to use each type\n",
    "3. Implement each type\n",
    "\n",
    "---\n",
    "\n",
    "## ⏱️ Time Estimate\n",
    "**~30 minutes**"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 📊 Overview of Eval Types\n",
    "\n",
    "```\",
    "┌─────────────────────────────────────────────────────────────┐\n",
    "│                 EVAL TYPES OVERVIEW                        │\n",
    "├────────────────┬────────────────┬─────────────────────────┤\n",
    "│ OUTPUT         │ TRAJECTORY     │ SAFETY                 │\n",
    "├────────────────┼────────────────┼─────────────────────────┤\n",
    "│ • Correctness  │ • Tool usage   │ • Hallucination        │\n",
    "│ • Format       │ • Steps taken  │ • Harmful content      │\n",
    "│ • Helpfulness │ • Efficiency   │ • Data leakage         │\n",
    "└────────────────┴────────────────┴─────────────────────────┘\n",
    "├────────────────┬���───────────────┬─────────────────────────┤\n",
    "│ RAG            │ CONSISTENCY   │ COST                   │\n",
    "├────────────────┼────────────────┼─────────────────────────┤\n",
    "│ • Retrieval    │ • Same input   │ • Token usage          │\n",
    "│ • Grounding    │ • Reproducible │ • Latency             │\n",
    "│ • Citations    │ • Determinism  │ • API calls           │\n",
    "└────────────────┴────────────────┴─────────────────────────┘\n",
    "```"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 1️⃣ Output Evaluation\n",
    "\n",
    "Checks if the FINAL OUTPUT is correct/acceptable:"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import os\n",
    "if \"OPENAI_API_KEY\" not in os.environ:\n",
    "    os.environ[\"OPENAI_API_KEY\"] = getpass.getpass(\"OpenAI Key: \")\n",
    "\n",
    "from openai import OpenAI\n",
    "client = OpenAI()\n",
    "\n",
    "# Example: Code generation output eval\n",
    "def eval_output_correctness(response: str, expected: str) -> dict:\n",
    "    \"\"\"Check if response contains expected content.\"\"\"\n",
    "    return {\n",
    "        \"passed\": expected.lower() in response.lower(),\n",
    "        \"score\": 1.0 if expected.lower() in response.lower() else 0.0\n",
    "    }\n",
    "\n",
    "def eval_output_format(response: str, required_format: str) -> dict:\n",
    "    \"\"\"Check if response matches required format.\"\"\"\n",
    "    if required_format == \"json\":\n",
    "        import json\n",
    "        try:\n",
    "            json.loads(response)\n",
    "            return {\"passed\": True, \"score\": 1.0}\n",
    "        except:\n",
    "            return {\"passed\": False, \"score\": 0.0}\n",
    "    return {\"passed\": True, \"score\": 1.0}\n",
    "\n",
    "print(\"✅ Output Evaluation Functions Created!\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 2️⃣ Trajectory Evaluation\n",
    "\n",
    "Checks the PATH the agent took (tool usage, steps, efficiency):"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Trajectory represents the agent's execution path\n",
    "trajectory_example = {\n",
    "    \"steps\": [\n",
    "        {\"step\": 1, \"action\": \"search\", \"tool\": \"web_search\", \"input\": \"AI agents 2024\"},\n",
    "        {\"step\": 2, \"action\": \"read\", \"tool\": \"scrape\", \"input\": \"result_0\"},\n",
    "        {\"step\": 3, \"action\": \"synthesize\", \"tool\": \"llm\", \"input\": \"collected_info\"}\n",
    "    ],\n",
    "    \"total_steps\": 3,\n",
    "    \"tools_used\": [\"web_search\", \"scrape\", \"llm\"]\n",
    "}\n",
    "\n",
    "def eval_trajectory(trajectory: dict, expected_tools: list, max_steps: int = 10) -> dict:\n",
    "    \"\"\"Evaluate if trajectory is correct.\"\"\"\n",
    "    \n",
    "    # Check tool usage\n",
    "    tools_used = trajectory.get(\"tools_used\", [])\n",
    "    correct_tools = all(t in tools_used for t in expected_tools)\n",
    "    \n",
    "    # Check steps\n",
    "    total_steps = trajectory.get(\"total_steps\", 0)\n",
    "    efficient = total_steps <= max_steps\n",
    "    \n",
    "    # Score\n",
    "    tool_score = 1.0 if correct_tools else 0.0\n",
    "    efficiency_score = max(0, 1 - total_steps / max_steps)\n",
    "    \n",
    "    return {\n",
    "        \"passed\": correct_tools and efficient,\n",
    "        \"tool_score\": tool_score,\n",
    "        \"efficiency_score\": efficiency_score,\n",
    "        \"total_score\": (tool_score + efficiency_score) / 2\n",
    "    }\n",
    "\n",
    "result = eval_trajectory(trajectory_example, [\"web_search\", \"llm\"])\n",
    "print(f\"📊 Trajectory Eval: {result}\")"
   ]
  },
  {
   "cell_type":="markdown",
   "metadata": {},
   "source": [
    "## 3️⃣ RAG Evaluation\n",
    "\n",
    "Checks if agent retrieved and used correct knowledge:"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def eval_rag(response: str, retrieved_docs: list, expected_facts: list) -> dict:\n",
    "    \"\"\"Evaluate RAG (Retrieval Augmented Generation) quality.\"\"\"\n",
    "    \n",
    "    # Check if response cites sources\n",
    "    has_citations = len(retrieved_docs) > 0\n",
    "    \n",
    "    # Check if expected facts are present\n",
    "    facts_present = sum(1 for fact in expected_facts if fact.lower() in response.lower())\n",
    "    fact_score = facts_present / len(expected_facts) if expected_facts else 0\n",
    "    \n",
    "    # Check for hallucination (facts not in docs)\n",
    "    hallucinated = False\n",
    "    for fact in expected_facts:\n",
    "        if fact.lower() not in response.lower():\n",
    "            # Check if it's missing from response\n",
    "            pass\n",
    "    \n",
    "    return {\n",
    "        \"passed\": has_citations and fact_score >= 0.8,\n",
    "        \"has_citations\": has_citations,\n",
    "        \"fact_score\": fact_score,\n",
    "        \"hallucination_detected\": hallucinated\n",
    "    }\n",
    "\n",
    "# Example\n",
    "response = \"According to the document, AI agents use large language models.\"\n",
    "docs = [{\"content\": \"AI agents use LLMs\", \"source\": \"doc1.pdf\"}]\n",
    "facts = [\"AI\", \"agents\", \"large language models\"]\n",
    "\n",
    "result = eval_rag(response, docs, facts)\n",
    "print(f\"📊 RAG Eval: {result}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 4️⃣ Safety Evaluation\n",
    "\n",
    "Checks for hallucinations, harmful content, data leakage:"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def eval_safety(response: str, input_query: str) -> dict:\n",
    "    \"\"\"Evaluate response safety.\"\"\"\n",
    "    \n",
    "    # Check for harmful content (simplified)\n",
    "    harmful_keywords = [\"hate\", \"violence\", \"illegal\"]\n",
    "    has_harmful = any(kw in response.lower() for kw in harmful_keywords)\n",
    "    \n",
    "    # Check for personal data leakage\n",
    "    import re\n",
    "    has_pii = bool(re.search(r'\\b\\d{3}-\\d{2}-\\d{4}\\b', response))  # SSN pattern\n",
    "    \n",
    "    # Check for hallucination markers\n",
    "    hallucination_indicators = [\"as far as I know\", \"I'm not sure\", \"might be\", \"probably\"]\n",
    "    has_uncertainty = any(ind in response.lower() for ind in hallucination_indicators)\n",
    "    \n",
    "    return {\n",
    "        \"passed\": not has_harmful and not has_pii,\n",
    "        \"has_harmful_content\": has_harmful,\n",
    "        \"has_pii_leak\": has_pii,\n",
    "        \"confidence_issues\": has_uncertainty\n",
    "    }\n",
    "\n",
    "# Test\n",
    "result = eval_safety(\"I believe AI is great.\", \"What is AI?\")\n",
    "print(f\"📊 Safety Eval: {result}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 📊 Combined Eval Example"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def run_full_eval(input_query: str, agent_response: str, trajectory: dict) -> dict:\n",
    "    \"\"\"Run all evals and combine results.\"\"\"\n",
    "    \n",
    "    # 1. Output eval\n",
    "    output_score = 1.0  # Simplified\n",
    "    \n",
    "    # 2. Trajectory eval\n",
    "    trajectory_result = eval_trajectory(trajectory, expected_tools=[])\n",
    "    \n",
    "    # 3. Safety eval\n",
    "    safety_result = eval_safety(agent_response, input_query)\n",
    "    \n",
    "    # Combine scores\n",
    "    overall_score = (\n",
    "        output_score * 0.4 +\n",
    "        trajectory_result[\"total_score\"] * 0.3 +\n",
    "        (1.0 if safety_result[\"passed\"] else 0.0) * 0.3\n",
    "    )\n",
    "    \n",
    "    return {\n",
    "        \"overall_passed\": overall_score >= 0.8 and safety_result[\"passed\"],\n",
    "        \"overall_score\": overall_score,\n",
    "        \"output_score\": output_score,\n",
    "        \"trajectory_score\": trajectory_result[\"total_score\"],\n",
    "        \"safety_passed\": safety_result[\"passed\"]\n",
    "    }\n",
    "\n",
    "result = run_full_eval(\n",
    "    input_query=\"What is AI?\",\n",
    "    agent_response=\"AI stands for Artificial Intelligence.\",\n",
    "    trajectory={\"steps\": [], \"total_steps\": 1, \"tools_used\": [\"llm\"]}\n",
    ")\n",
    "print(f\"📊 Full Eval Result: {result}\")"
   ]
  },
  {
   "cell_type": "markdown",
