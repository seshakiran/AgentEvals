   "source": [
    "# 📖 Building Agents with LangGraph\n",
    "\n",
    "---\n",
    "\n",
    "## 🎯 Learning Objectives\n",
    "\n",
    "1. Understand LangGraph concepts (nodes, edges, state)\n",
    "2. Build stateful agents with LangGraph\n",
    "3. Use conditional edges for decision-making\n",
    "\n",
    "---\n",
    "\n",
    "## ⏱️ Time Estimate\n",
    "**~35 minutes**"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "!pip install -q langgraph langchain-openai langchain-core\n",
    "import os\n",
    "if \"OPENAI_API_KEY\" not in os.environ:\n",
    "    import getpass\n",
    "    os.environ[\"OPENAI_API_KEY\"] = getpass.getpass(\"OpenAI Key: \")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 🧠 LangGraph Core Concepts\n",
    "\n",
    "```\n",
    "┌─────────────────────────────────────────────────────┐\n",
    "│             LANGGRAPH CONCEPTS                       │\n",
    "├─────────────────────────────────────────────────────┤\n",
    "│  • NODE = Function that processes state            │\n",
    "│  • EDGE = Connection between nodes                 │\n",
    "│  • STATE = Data flowing through the graph          │\n",
    "│  • CONDITIONAL EDGE = Decision-based routing       │\n",
    "└─────────────────────────────────────────────────────┘\n",
    "```"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "from langgraph.graph import StateGraph, END\n",
    "from typing import TypedDict, Annotated\n",
    "from langchain_openai import ChatOpenAI\n",
    "from langchain_core.messages import HumanMessage, AIMessage\n",
    "from operator import add\n",
    "\n",
    "# Define state\n",
    "class AgentState(TypedDict):\n",
    "    messages: Annotated[list, add]\n",
    "    step: int\n",
    "\n",
    "# Create LLM\n",
    "llm = ChatOpenAI(model=\"gpt-4o-mini\")\n",
    "\n",
    "# Node 1: Router\n",
    "def router(state: AgentState) -> AgentState:\n",
    "    \"\"\"Decide next step based on last message.\"\"\"\n",
    "    messages = state[\"messages\"]\n",
    "    last_msg = messages[-1].content.lower()\n",
    "    \n",
    "    state[\"step\"] = state.get(\"step\", 0) + 1\n",
    "    print(f\"📍 Step {state['step']}: Router analyzing...\")\n",
    "    \n",
    "    if \"weather\" in last_msg:\n",
    "        return {\"next\": \"weather\", **state}\n",
    "    elif \"calculate\" in last_msg or any(op in last_msg for op in [\"+\", \"-\", \"*\", \"/\"]):\n",
    "        return {\"next\": \"calculator\", **state}\n",
    "    else:\n",
    "        return {\"next\": \"general\", **state}\n",
    "\n",
    "# Node 2: Weather\n",
    "def weather(state: AgentState) -> AgentState:\n",
    "    \"\"\"Get weather info.\"\"\"\n",
    "    print(\"🔧 Getting weather...\")\n",
    "    response = llm.invoke([HumanMessage(content=f\"{state['messages'][-1].content} - respond with weather info\")])\n",
    "    state[\"messages\"].append(AIMessage(content=response.content))\n",
    "    return state\n",
    "\n",
    "# Node 3: Calculator\n",
    "def calculator(state: AgentState) -> AgentState:\n",
    "    \"\"\"Calculate.\"\"\"\n",
    "    print(\"🔧 Calculating...\")\n",
    "    response = llm.invoke([HumanMessage(content=f\"{state['messages'][-1].content} - just do the math\")])\n",
    "    state[\"messages\"].append(AIMessage(content=response.content))\n",
    "    return state\n",
    "\n",
    "# Node 4: General\n",
    "def general(state: AgentState) -> AgentState:\n",
    "    \"\"\"General response.\"\"\"\n",
    "    print(\"🔧 General response...\")\n",
    "    response = llm.invoke(state[\"messages\"])\n",
    "    state[\"messages\"].append(AIMessage(content=response.content))\n",
    "    return state"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Build the graph\n",
    "graph = StateGraph(AgentState)\n",
    "\n",
    "# Add nodes\n",
    "graph.add_node(\"router\", router)\n",
    "graph.add_node(\"weather\", weather)\n",
    "graph.add_node(\"calculator\", calculator)\n",
    "graph.add_node(\"general\", general)\n",
    "\n",
    "# Entry point\n",
    "graph.set_entry_point(\"router\")\n",
    "\n",
    "# Conditional routing\n",
    "def route_decision(state: AgentState) -> str:\n",
    "    return state.get(\"next\", \"general\")\n",
    "\n",
    "graph.add_conditional_edges(\n",
    "    \"router\",\n",
    "    route_decision,\n",
    "    {\"weather\": \"weather\", \"calculator\": \"calculator\", \"general\": \"general\"}\n",
    ")\n",
    "\n",
    "# End after each handler\n",
    "graph.add_edge(\"weather\", END)\n",
    "graph.add_edge(\"calculator\", END)\n",
    "graph.add_edge(\"general\", END)\n",
    "\n",
    "# Compile\n",
    "app = graph.compile()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Run the agent\n",
    "print(\"=\" * 60)\n",
    "print(\"📍 Test: Weather query\")\n",
    "print(\"=\" * 60)\n",
    "\n",
    "initial_state = AgentState(\n",
    "    messages=[HumanMessage(content=\"What's the weather in Paris?\")],\n",
    "    step=0\n",
    ")\n",
    "\n",
    "result = app.invoke(initial_state)\n",
    "print(f\"\\n✅ Final response: {result['messages'][-1].content}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Test with math\n",
    "print(\"=\" * 60)\n",
    "print(\"📍 Test: Math query\")\n",
    "print(\"=\" * 60)\n",
    "\n",
    "initial_state = AgentState(\n",
    "    messages=[HumanMessage(content=\"What is 25 * 17?\")],\n",
    "    step=0\n",
    ")\n",
    "\n",
    "result = app.invoke(initial_state)\n",
    "print(f\"\\n✅ Final response: {result['messages'][-1].content}\")"
   ]
  },
