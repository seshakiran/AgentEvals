    "\n",
    "```\",
    "START → [Router] → ─┬─ [Weather] → END\n",
    "                   ├─ [Calculator] → END\n",
    "                   └─ [General] → END\n",
    "\n",
    "Router: Analyzes message → Routes to appropriate handler"
   ]
